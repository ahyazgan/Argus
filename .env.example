# ============================================================
# Argus Intelligence - ortam degiskenleri
# Bu dosyayi ".env" olarak kopyalayin ve degerleri doldurun.
# ============================================================

# --- Genel ---
ENVIRONMENT=development
DEBUG=true

# --- Veritabani (PostgreSQL) ---
POSTGRES_USER=argus
POSTGRES_PASSWORD=argus_dev_password
POSTGRES_DB=argus
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Async SQLAlchemy baglanti dizesi (docker icinde host=postgres)
DATABASE_URL=postgresql+asyncpg://argus:argus_dev_password@postgres:5432/argus

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Guvenlik / JWT ---
# Uretimde guclu rastgele bir deger kullanin: `openssl rand -hex 32`
JWT_SECRET=change-me-in-production-please
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=
# Triyaj/analiz icin maliyet-etkin modeller
CLAUDE_TRIAGE_MODEL=claude-haiku-4-5
CLAUDE_SUMMARY_MODEL=claude-sonnet-4-6

# --- Stripe (odeme - simdilik stub) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ENABLED=false

# --- Bildirim (SMTP / e-posta) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@argus.local

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
