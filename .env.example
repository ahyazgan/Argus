# ============================================================
# Argus Intelligence - ortam degiskenleri
# Bu dosyayi ".env" olarak kopyalayin ve degerleri doldurun.
# ============================================================

# --- Genel ---
ENVIRONMENT=development
DEBUG=true

# --- Veritabani (PostgreSQL) ---
POSTGRES_USER=argus
POSTGRES_PASSWORD=argus_dev_password
POSTGRES_DB=argus
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Async SQLAlchemy baglanti dizesi (docker icinde host=postgres)
DATABASE_URL=postgresql+asyncpg://argus:argus_dev_password@postgres:5432/argus

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
# Zamanlanmis tarama dispatcher'inin (Celery beat) calisma sikligi (saniye)
SCAN_BEAT_INTERVAL_SECONDS=60

# --- Guvenlik / JWT ---
# Uretimde guclu rastgele bir deger kullanin: `openssl rand -hex 32`
JWT_SECRET=change-me-in-production-please
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=
# Triyaj/analiz icin maliyet-etkin modeller
CLAUDE_TRIAGE_MODEL=claude-haiku-4-5
CLAUDE_SUMMARY_MODEL=claude-sonnet-4-6

# --- Stripe (odeme) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ENABLED=false
# Plan kademesi basina Stripe Price ID'leri (STRIPE_ENABLED=true ise gerekli)
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# --- OSINT feed API anahtarlari (bos ise konnektor demo/atlanir) ---
HIBP_API_KEY=
SHODAN_API_KEY=
# Marka koruma: gercek DNS-over-HTTPS dogrulamasi (anahtarsiz; true=ac)
BRAND_DNS_CHECK=false
# Diger modullerin gercek kaynaklari (saglayici sozlesmesi gerektirir)
BRAND_FEED_API_KEY=
SEARCH_API_KEY=
CHAIN_ANALYSIS_API_KEY=
SCRAPE_API_KEY=
SOCIAL_API_KEY=
COURT_RECORDS_API_KEY=
AI_PROBE_API_KEY=

# --- Bildirim ---
# Bu onem seviyesi ve uzerindeki YENI bulgular bildirilir (info|low|medium|high|critical)
NOTIFY_MIN_SEVERITY=info

# --- Bildirim (SMTP / e-posta) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@argus.local

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
